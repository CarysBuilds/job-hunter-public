{
  "name": "job-hunter",
  "version": "0.2.0",
  "private": true,
  "description": "Local desktop job discovery and matching assistant",
  "license": "MIT",
  "homepage": "https://github.com/CarysBuilds/job-hunter-public#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarysBuilds/job-hunter-public.git"
  },
  "bugs": {
    "url": "https://github.com/CarysBuilds/job-hunter-public/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/index.js",
    "login": "tsx src/scripts/login.ts",
    "crawl": "tsx src/index.ts --crawl-only",
    "test": "node --import ./test/setup-env.mjs --import tsx --test --test-timeout=120000 --test-force-exit test/*.test.ts",
    "test:ci": "node --import ./test/setup-env.mjs --import tsx --test --test-timeout=120000 --test-force-exit test/api.test.ts test/company-research.test.ts test/greeting.test.ts test/llm.test.ts test/run-service.test.ts test/scorer.test.ts test/service.test.ts test/store.test.ts",
    "test:coverage": "node --import ./test/setup-env.mjs --import tsx --test --test-timeout=120000 --test-force-exit --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/types.ts' --test-coverage-lines=75 --test-coverage-branches=65 --test-coverage-functions=70 test/*.test.ts",
    "test:worker": "node --import ./test/setup-env.mjs --import tsx --test --test-timeout=120000 --test-force-exit test/worker-e2e.test.ts",
    "audit": "npm audit --audit-level=high",
    "security:guards": "node scripts/security-guards.mjs",
    "check": "npm run check:node && npm run security:guards && npm run typecheck:all && npm run lint && npm run test:coverage && npm run build && npm run audit && npm run test:worker",
    "scan:sensitive": "node scripts/scan-sensitive.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "smoke:windows": "node scripts/smoke-windows.mjs",
    "package:macos": "node scripts/package-macos.mjs",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "db:status": "tsx src/scripts/database.ts status",
    "db:backup": "tsx src/scripts/database.ts backup",
    "db:restore": "tsx src/scripts/database.ts restore",
    "mock": "tsx src/scripts/seed.ts",
    "service:install": "npm run build && tsx src/scripts/service.ts install",
    "service:status": "tsx src/scripts/service.ts status",
    "service:restart": "npm run build && tsx src/scripts/service.ts restart",
    "service:logs": "tsx src/scripts/service.ts logs",
    "service:uninstall": "tsx src/scripts/service.ts uninstall"
  },
  "dependencies": {
    "express": "^4.22.2",
    "openai": "^4.77.0",
    "playwright": "^1.49.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/qs": "^6.15.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
